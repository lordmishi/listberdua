    function meterList(id: string, rows: { key: string; n: number }[], name: (key: string) => string, empty: string) {
      const list = $(id);
      if (rows.length === 0) {
        list.replaceChildren(Object.assign(document.createElement('li'), { className: 'text-sm text-muted', textContent: empty }));
        return;
      }
      const max = rows[0].n;
      list.replaceChildren(
        ...rows.map((row) => {
          const li = document.createElement('li');
          const top = document.createElement('div');
          top.className = 'flex justify-between gap-3 text-sm';
          top.append(
            Object.assign(document.createElement('span'), { className: 'min-w-0 truncate', textContent: name(row.key), title: name(row.key) }),
            Object.assign(document.createElement('span'), { className: 'font-semibold tabular-nums', textContent: fmt(row.n) }),
          );
          const track = document.createElement('div');
          track.className = 'mt-1 h-1 rounded-full bg-line';
          const fill = document.createElement('div');
          fill.className = 'h-1 rounded-full bg-ink';
          fill.style.width = `${Math.max(2, (row.n / max) * 100)}%`;
          track.append(fill);
          li.append(top, track);
          return li;
        }),
      );
    }

    const dateLabel = (day: string) => new Date(day + 'T00:00:00').toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });

    function drawChart(days: { day: string; visitor: number; view: number; click: number }[]) {
      const area = $('#grafik-batang');
      const tip = $('#grafik-tip');
      const max = Math.max(1, ...days.map((d) => d.visitor));
      $('#grafik-maks').textContent = `Tertinggi ${fmt(max)} dalam sehari`;
      area.style.gap = days.length > 40 ? '1px' : '2px';
      area.replaceChildren(
        ...days.map((d) => {
          const bar = document.createElement('span');
          bar.className = 'relative flex h-full flex-1 items-end outline-offset-1';
          bar.tabIndex = 0;
          bar.setAttribute('aria-label', `${dateLabel(d.day)}: ${fmt(d.visitor)} pengunjung`);
          const fill = document.createElement('span');
          fill.className = 'block w-full rounded-t bg-ink transition-colors';
          fill.style.height = d.visitor ? `${Math.max(2, (d.visitor / max) * 100)}%` : '0';
          bar.append(fill);
          const show = () => {
            tip.replaceChildren(
              Object.assign(document.createElement('strong'), { textContent: `${fmt(d.visitor)} pengunjung` }),
              document.createTextNode(` · ${dateLabel(d.day)}`),
            );
            tip.hidden = false;
            const box = area.getBoundingClientRect();
            const mark = bar.getBoundingClientRect();
            const left = Math.min(Math.max(mark.left - box.left + mark.width / 2 - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
            tip.style.left = `${left}px`;
            tip.style.top = '-2rem';
            fill.style.backgroundColor = '#5b6067';
          };
          const hide = () => {
            tip.hidden = true;
            fill.style.backgroundColor = '';
          };
          bar.addEventListener('pointerenter', show);
          bar.addEventListener('pointerleave', hide);
          bar.addEventListener('focus', show);
          bar.addEventListener('blur', hide);
          return bar;
        }),
      );
      const axis = $('#grafik-sumbu');
      const middle = days[Math.floor(days.length / 2)];
      axis.replaceChildren(
        ...[days[0], middle, days[days.length - 1]].map((d) => Object.assign(document.createElement('span'), { textContent: dateLabel(d.day) })),
      );
      $('#tabel-harian').replaceChildren(
        ...[...days].reverse().map((d) => {
          const row = document.createElement('tr');
          row.className = 'border-t border-line';
          row.append(
            Object.assign(document.createElement('td'), { className: 'py-1', textContent: dateLabel(d.day) }),
            ...[d.visitor, d.view, d.click].map((n) => Object.assign(document.createElement('td'), { className: 'py-1 text-right', textContent: fmt(n) })),
          );
          return row;
        }),
      );
    }

    async function loadStats() {
      statBody.hidden = true;
      statMessage.hidden = false;
      const key = keyInput.value.trim();
      if (!key) {
        statMessage.textContent = 'Statistik belum tersambung. Ikuti langkah “Menyalakan statistik” di README, lalu isi kunci di “Pengaturan statistik” di bawah.';
        $<HTMLDetailsElement>('#stat-atur').open = true;
        return;
      }
      statMessage.textContent = 'Memuat statistik...';
      try {
        const res = await fetch(`/api/stats?days=${$<HTMLSelectElement>('#stat-periode').value}`, {
          headers: { Authorization: `Bearer ${key}` },
          cache: 'no-store',
        });
        const data = await res.json().catch(() => ({ error: 'not-json' }));
        if (!res.ok || data.error) {
          statMessage.textContent =
            data.error === 'wrong-key' ? 'Kunci statistik salah. Periksa lagi di “Pengaturan statistik”.'
            : data.error === 'no-db' ? 'Database statistik belum tersambung. Lihat langkah 1 dan 2 di README bagian “Menyalakan statistik”.'
            : data.error === 'no-key' ? 'Secret STATS_KEY belum dibuat di Cloudflare. Lihat langkah 3 di README bagian “Menyalakan statistik”.'
            : 'Statistik belum bisa dimuat. Pastikan perintah deploy di Cloudflare sudah diganti (README, langkah 4), lalu coba lagi.';
          return;
        }
        const days = data.days as { day: string; visitor: number; view: number; click: number }[];
        const total = (k: 'visitor' | 'view' | 'click') => days.reduce((sum, d) => sum + d[k], 0);
        const visitors = total('visitor');
        const clicks = total('click');
        $('#kpi-pengunjung').textContent = fmt(visitors);
        $('#kpi-dilihat').textContent = fmt(total('view'));
        $('#kpi-klik').textContent = fmt(clicks);
        $('#kpi-rasio').textContent = visitors ? fmt(Math.round((clicks / visitors) * 100)) : '–';
        if (visitors === 0 && total('view') === 0) {
          statMessage.textContent = 'Statistik sudah tersambung, tapi belum ada kunjungan tercatat di periode ini.';
          return;
        }
        drawChart(days);
        meterList('#top-klik', data.top.click, productName, 'Belum ada klik ke Shopee.');
        meterList('#top-asal', data.top.source, sourceName, 'Belum ada data asal pengunjung.');
        meterList('#top-hal', data.top.view, pageName, 'Belum ada halaman dilihat.');
        statMessage.hidden = true;
        statBody.hidden = false;
      } catch {
        statMessage.textContent = 'Statistik belum bisa dimuat. Periksa koneksi internet, lalu ketuk “Muat ulang”.';
      }
    }

    loadSettings();
    renderBanners();
    renderList();
    renderGuides();
    loadStats();
  }

  document.addEventListener('astro:page-load', setUpAdmin);
</script>
