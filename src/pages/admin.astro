    // ---- collection banners
    async function squareCrop(file: File, size: number) {
      const bitmap = await createImageBitmap(file);
      const side = Math.min(bitmap.width, bitmap.height);
      const canvas = document.createElement('canvas');
      canvas.width = canvas.height = size;
      canvas.getContext('2d')!.drawImage(bitmap, (bitmap.width - side) / 2, (bitmap.height - side) / 2, side, side, 0, 0, size, size);
      return canvas.toDataURL('image/jpeg', 0.85);
    }

    function renderBanners() {
      const box = $('#daftar-banner');
      box.replaceChildren(
        ...(seed.collectionList as { slug: string; name: string }[]).map((c, i) => {
          const li = document.createElement('li');
          li.className = 'flex flex-wrap items-center gap-3 py-3';
          const preview = document.createElement('img');
          preview.className = 'size-16 shrink-0 rounded-xl bg-panel object-cover';
          preview.alt = '';
          preview.width = preview.height = 64;
          preview.src = banners.get(c.slug) ?? `/images/koleksi/${c.slug}.jpg`;
          // No banner on the site yet: keep the plain dark square.
          preview.addEventListener('error', () => preview.removeAttribute('src'));
          const text = document.createElement('div');
          text.className = 'min-w-0 flex-1 basis-40';
          const label = Object.assign(document.createElement('label'), { className: 'field-label', htmlFor: `banner-${i}`, textContent: c.name });
          const input = Object.assign(document.createElement('input'), { type: 'file', accept: 'image/*', id: `banner-${i}`, className: 'field' });
          input.addEventListener('change', async () => {
            const file = input.files?.[0];
            if (!file) return;
            try {
              banners.set(c.slug, await squareCrop(file, 800));
              setDirty(true);
              renderBanners();
              renderPhotoDownloads();
              say(`Banner “${c.name}” siap. Ketuk “Publikasikan ke situs” supaya tampil.`);
            } catch {
              say('Gambar itu tidak bisa dibaca. Coba file JPG atau PNG lain.');
            }
          });
          text.append(label, input);
          li.append(preview, text);
          return li;
        }),
      );
    }

