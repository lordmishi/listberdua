    // ---- batch import: rows pasted from a spreadsheet (tabs) or a CSV file (commas)
    function parseTable(text: string): string[][] {
      text = text.replace(/^\uFEFF/, '');
      const delimiter = text.split(/\r?\n/, 1)[0].includes('\t') ? '\t' : ',';
      const rows: string[][] = [];
      let row: string[] = [];
      let cell = '';
      let quoted = false;
      for (let i = 0; i < text.length; i++) {
        const c = text[i];
        if (quoted) {
          if (c === '"' && text[i + 1] === '"') { cell += '"'; i++; }
          else if (c === '"') quoted = false;
          else cell += c;
        } else if (c === '"' && cell === '') quoted = true;
        else if (c === delimiter) { row.push(cell); cell = ''; }
        else if (c === '\n' || c === '\r') {
          if (c === '\r' && text[i + 1] === '\n') i++;
          row.push(cell); rows.push(row); row = []; cell = '';
        } else cell += c;
      }
      if (cell !== '' || row.length) { row.push(cell); rows.push(row); }
      return rows.filter((r) => r.some((value) => value.trim() !== ''));
    }

    const isShopeeLink = (link: string) => /^https:\/\/([a-z0-9-]+\.)*(shopee\.co\.id|shope\.ee)\//i.test(link);

    function importRows(text: string) {
      const result = $('#impor-hasil');
      const lines: string[] = [];
      const rows = parseTable(text);
      const header = (rows.shift() ?? []).map((h) => h.trim().toLowerCase());
      if (!header.includes('nama') || !header.includes('kategori')) {
        lines.push('Baris pertama harus berisi judul kolom, minimal “nama” dan “kategori”. Tidak ada yang ditambahkan.');
      } else {
        let added = 0;
        rows.forEach((cells, index) => {
          const line = index + 2;
          const r = Object.fromEntries(header.map((h, i) => [h, (cells[i] ?? '').trim()]));
          if (!r.nama) return void lines.push(`Baris ${line} dilewati: nama kosong.`);
          const category = categories.find((c) => c.name.toLowerCase() === r.kategori.toLowerCase() || c.slug === r.kategori.toLowerCase());
          if (!category) return void lines.push(`Baris ${line} (${r.nama}) dilewati: kategori “${r.kategori}” tidak dikenal.`);
          const slug = slugify(r.nama);
          if (!slug) return void lines.push(`Baris ${line} dilewati: nama harus mengandung huruf atau angka.`);
          // Older products have slugs that differ from their names, so names are compared too.
          if (items.some((i) => i.slug === slug || i.name.toLowerCase() === r.nama.toLowerCase())) {
            return void lines.push(`Baris ${line} (${r.nama}) dilewati: sudah ada produk dengan nama itu.`);
          }
          let link = r.link_shopee ?? '';
          if (link && !isShopeeLink(link)) {
            lines.push(`Baris ${line} (${r.nama}): link bukan link Shopee, jadi dikosongkan.`);
            link = '';
          }
          const known = (r.koleksi ?? '').split(';').map((c) => c.trim()).filter(Boolean);
          const unknown = known.filter((c) => !(seed.collections as string[]).includes(c));
          if (unknown.length) lines.push(`Baris ${line} (${r.nama}): koleksi “${unknown.join(', ')}” tidak dikenal, jadi dilewati.`);
          const price = (r.harga ?? '').replace(/\D/g, '');
          const item: Item = {
            id: slug,
            slug,
            name: r.nama,
            category: category.name,
            categorySlug: category.slug,
            collection: known.filter((c) => !unknown.includes(c)),
            priceEstimate: price ? 'Rp' + Number(price).toLocaleString('id-ID') : '',
            soldLabel: r.terjual ?? '',
            storeBadge: r.badge ?? '',
            quickTag: r.tag ?? '',
            affiliateUrl: link,
            highlights: [r.keunggulan_1, r.keunggulan_2, r.keunggulan_3].filter(Boolean),
            wifeNote: r.kata_istri ?? '',
            husbandNote: r.catatan_suami ?? '',
            bestFor: r.cocok_untuk ?? '',
            caveat: r.perhatikan ?? '',
            priceCheckedAt: price ? today() : '',
          };
          (Object.keys(item) as (keyof Item)[]).forEach((key) => {
            if (item[key] === '') delete item[key];
          });
          items.push(item);
          added++;
        });
        lines.unshift(
          added > 0
            ? `${added} produk ditambahkan ke daftar. Lengkapi fotonya, lalu ketuk “Publikasikan ke situs”.`
            : 'Tidak ada produk yang ditambahkan.',
        );
        if (added > 0) {
          setDirty(true);
          renderList();
          $<HTMLTextAreaElement>('#impor-teks').value = '';
        }
      }
      result.replaceChildren(...lines.map((text) => Object.assign(document.createElement('p'), { textContent: text })));
      result.classList.remove('hidden');
    }

