    const productName = (slug: string) => items.find((i) => i.slug === slug)?.name ?? slug;
    const sourceName = (key: string) =>
      ({ langsung: 'Langsung atau tidak diketahui', threads: 'Threads', instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', x: 'X', whatsapp: 'WhatsApp', google: 'Google', bing: 'Bing' })[key] ?? key;
    const pageName = (path: string) => {
      if (path === '/') return 'Beranda';
      const [, type, slug] = path.split('/');
      if (type === 'produk') return productName(slug);
      if (type === 'kategori') return categories.find((c) => c.slug === slug)?.name ?? path;
