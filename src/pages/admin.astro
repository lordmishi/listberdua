---
import Base from '../layouts/Base.astro';
import { products } from '../lib/catalog';
import { guides } from '../lib/guides';
import { categories, collections, site } from '../data/site';

const seed = {
  products,
  categories,
  collections: collections.map((c) => c.name),
  collectionList: collections.map((c) => ({ slug: c.slug, name: c.name })),
  sampleMode: site.sampleMode,
  hasContact: Boolean(site.contactEmail),
  guides,
};
// A bare "<" inside the embedded JSON could close the script tag early.
const seedText = JSON.stringify(seed).replace(/</g, '\\u003c');
---

<Base title="Dasbor" description="Dasbor pemilik ListBerdua untuk mengelola produk." noindex owner>
  <section class="wrap max-w-4xl pt-4" id="admin">
    <h1 class="text-3xl font-bold">Dasbor</h1>
    <p class="mt-1 text-muted" id="ringkasan-baris"></p>

    <p id="admin-pesan" role="status" class="mt-4 hidden rounded-2xl bg-card px-4 py-3 text-sm"></p>

    <div id="tampilan-daftar">
      <nav aria-label="Bagian dasbor" class="mt-4">
        <ul class="pill-row -mx-4 flex gap-2 overflow-x-auto px-4">
          <li class="shrink-0"><a class="inline-flex min-h-11 items-center rounded-full bg-card px-4 text-sm font-medium no-underline hover:bg-line" href="#statistik">Statistik</a></li>
          <li class="shrink-0"><a class="inline-flex min-h-11 items-center rounded-full bg-card px-4 text-sm font-medium no-underline hover:bg-line" href="#judul-lengkapi">Perlu dikerjakan</a></li>
          <li class="shrink-0"><a class="inline-flex min-h-11 items-center rounded-full bg-card px-4 text-sm font-medium no-underline hover:bg-line" href="#judul-admin-daftar">Produk</a></li>
          <li class="shrink-0"><a class="inline-flex min-h-11 items-center rounded-full bg-card px-4 text-sm font-medium no-underline hover:bg-line" href="#panduan">Panduan</a></li>
          <li class="shrink-0"><a class="inline-flex min-h-11 items-center rounded-full bg-card px-4 text-sm font-medium no-underline hover:bg-line" href="#impor">Lainnya</a></li>
        </ul>
      </nav>
      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" id="tombol-tambah" class="btn btn-dark">Tambah produk</button>
        <button type="button" id="tombol-terbitkan" class="btn btn-quiet">Publikasikan ke situs</button>
      </div>
      <p id="status-ubah" class="mt-2 text-sm text-muted"></p>

      <section class="mt-7" aria-labelledby="judul-statistik" id="statistik">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="text-xl font-bold" id="judul-statistik">Statistik</h2>
          <div class="flex flex-wrap items-end gap-2">
            <div>
              <label class="field-label" for="stat-periode">Periode</label>
              <select class="field !min-h-11" id="stat-periode">
                <option value="7">7 hari terakhir</option>
                <option value="30" selected>30 hari terakhir</option>
                <option value="90">90 hari terakhir</option>
              </select>
            </div>
            <button type="button" id="stat-muat" class="btn btn-quiet !min-h-11">Muat ulang</button>
          </div>
        </div>

        <p id="stat-pesan" role="status" class="mt-3 text-sm text-muted">Memuat statistik...</p>

        <div id="stat-isi" hidden>
          <dl class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
            <div class="rounded-2xl bg-card p-4"><dt class="text-sm text-muted">Pengunjung</dt><dd class="mt-1 text-2xl font-semibold tabular-nums" id="kpi-pengunjung"></dd></div>
            <div class="rounded-2xl bg-card p-4"><dt class="text-sm text-muted">Halaman dilihat</dt><dd class="mt-1 text-2xl font-semibold tabular-nums" id="kpi-dilihat"></dd></div>
            <div class="rounded-2xl bg-card p-4"><dt class="text-sm text-muted">Klik ke Shopee</dt><dd class="mt-1 text-2xl font-semibold tabular-nums" id="kpi-klik"></dd></div>
            <div class="rounded-2xl bg-card p-4"><dt class="text-sm text-muted">Klik per 100 pengunjung</dt><dd class="mt-1 text-2xl font-semibold tabular-nums" id="kpi-rasio"></dd></div>
          </dl>
          <p class="mt-2 text-sm text-muted">Satu perangkat dihitung sebagai satu pengunjung per hari.</p>

          <figure class="mt-4 rounded-2xl bg-card p-4">
            <figcaption class="flex flex-wrap items-baseline justify-between gap-x-3">
              <span class="font-semibold">Pengunjung per hari</span>
              <span class="text-sm text-muted tabular-nums" id="grafik-maks"></span>
            </figcaption>
            <div class="relative mt-10">
              <div class="flex h-36 items-end border-b border-edge" id="grafik-batang"></div>
              <div id="grafik-tip" role="tooltip" hidden class="pointer-events-none absolute z-10 whitespace-nowrap rounded-lg bg-ink px-2.5 py-1.5 text-xs text-white"></div>
            </div>
            <div class="mt-1 flex justify-between text-xs text-muted" id="grafik-sumbu"></div>
            <details class="mt-3">
              <summary class="flex min-h-11 items-center text-sm font-semibold">Lihat sebagai tabel</summary>
              <div class="max-h-72 overflow-auto">
                <table class="w-full text-sm tabular-nums">
                  <thead><tr class="text-left text-muted"><th class="py-1 font-medium">Tanggal</th><th class="py-1 text-right font-medium">Pengunjung</th><th class="py-1 text-right font-medium">Dilihat</th><th class="py-1 text-right font-medium">Klik</th></tr></thead>
                  <tbody id="tabel-harian"></tbody>
                </table>
              </div>
            </details>
          </figure>

          <div class="mt-4 grid gap-4 md:grid-cols-3">
            <section class="min-w-0 rounded-2xl bg-card p-4" aria-labelledby="judul-top-klik">
              <h3 class="font-semibold" id="judul-top-klik">Paling sering diklik</h3>
              <ol class="mt-2 space-y-2.5" id="top-klik"></ol>
            </section>
            <section class="min-w-0 rounded-2xl bg-card p-4" aria-labelledby="judul-top-asal">
              <h3 class="font-semibold" id="judul-top-asal">Asal pengunjung</h3>
              <ol class="mt-2 space-y-2.5" id="top-asal"></ol>
            </section>
            <section class="min-w-0 rounded-2xl bg-card p-4" aria-labelledby="judul-top-hal">
              <h3 class="font-semibold" id="judul-top-hal">Halaman paling sering dilihat</h3>
              <ol class="mt-2 space-y-2.5" id="top-hal"></ol>
            </section>
          </div>
          <p class="mt-3 text-sm text-muted">
            Klik adalah ketukan tombol “Buka di Aplikasi Shopee”. Pesanan dan komisi hanya tercatat di dasbor Shopee
            Affiliate. Tambahkan <code class="whitespace-nowrap">?src=threads</code> (atau nama lain) di akhir link yang kamu bagikan supaya asal
            pengunjung tercatat tepat.
          </p>
        </div>

        <details class="mt-3 rounded-2xl bg-card px-4 py-1.5" id="stat-atur">
          <summary class="py-2.5 font-semibold">Pengaturan statistik</summary>
          <div class="mt-1 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
              <label class="field-label" for="stat-kunci">Kunci statistik</label>
              <input class="field" id="stat-kunci" type="password" autocomplete="off" />
              <p class="field-hint">Sama dengan secret STATS_KEY yang kamu buat di Cloudflare. Disimpan di browser ini saja.</p>
            </div>
            <button type="button" id="stat-simpan" class="btn btn-dark">Simpan kunci</button>
          </div>
          <label class="mt-3 flex min-h-11 items-center gap-2 text-sm">
            <input type="checkbox" id="stat-abaikan" class="size-5" />
            Jangan hitung kunjungan dari perangkat ini (supaya kunjunganmu sendiri tidak ikut terhitung)
          </label>
          <div class="h-3"></div>
        </details>
      </section>

      <div class="mt-7 grid gap-4 md:grid-cols-[1.4fr_1fr]">
        <section class="rounded-2xl bg-card p-4" aria-labelledby="judul-lengkapi">
          <h2 class="text-lg font-bold" id="judul-lengkapi">Perlu dilengkapi</h2>
          <ul id="daftar-lengkapi" class="mt-2 divide-y divide-line"></ul>
          <p id="lengkapi-kosong" hidden class="mt-2 text-muted">Semua produk sudah punya foto, link Shopee, harga, dan dua catatan.</p>

          <h2 class="mt-6 text-lg font-bold" id="judul-harga">Harga perlu dicek ulang</h2>
          <p class="mt-1 text-sm text-muted">Produk yang harganya belum dicek di Shopee lebih dari 30 hari.</p>
          <ul id="daftar-harga" class="mt-2 divide-y divide-line"></ul>
          <p id="harga-kosong" hidden class="mt-2 text-muted">Semua harga sudah dicek dalam 30 hari terakhir.</p>
        </section>

        <div class="grid content-start gap-4">
          <section class="rounded-2xl bg-card p-4" aria-labelledby="judul-situs">
            <h2 class="text-lg font-bold" id="judul-situs">Keadaan situs</h2>
            <ul id="daftar-situs" class="mt-2 space-y-2 text-sm"></ul>
          </section>
          <section class="rounded-2xl bg-card p-4" aria-labelledby="judul-isi">
            <h2 class="text-lg font-bold" id="judul-isi">Isi per kategori</h2>
            <table class="mt-2 w-full text-sm">
              <thead class="sr-only"><tr><th>Kategori</th><th>Jumlah produk</th></tr></thead>
              <tbody id="tabel-kategori"></tbody>
            </table>
          </section>
        </div>
      </div>

      <div class="mb-2 mt-8 flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-xl font-bold" id="judul-admin-daftar" tabindex="-1">Daftar produk</h2>
        <div class="flex flex-wrap gap-2">
          <div>
            <label class="field-label" for="saring-teks">Cari nama</label>
            <input class="field !min-h-11" id="saring-teks" type="search" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="saring-kategori">Kategori</label>
            <select class="field !min-h-11" id="saring-kategori"><option value="">Semua</option></select>
          </div>
        </div>
      </div>
      <ul id="daftar-admin" class="divide-y divide-line border-y border-line"></ul>
      <p id="daftar-kosong" hidden class="py-6 text-muted">Belum ada produk. Ketuk “Tambah produk” untuk mulai.</p>
      <p id="saring-kosong" hidden class="py-6 text-muted">Tidak ada produk yang cocok dengan saringan itu.</p>
      <p class="mt-3 text-sm text-muted">
        Jumlah klik, pesanan, dan komisi tidak tercatat di sini. Lihat di{' '}
        <a class="underline" href="https://affiliate.shopee.co.id/" target="_blank" rel="noopener noreferrer">dasbor Shopee Affiliate</a>,
        menu Laporan.
      </p>

      <section class="mt-10" id="panduan" aria-labelledby="judul-panduan-admin">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="text-xl font-bold" id="judul-panduan-admin" tabindex="-1">Panduan</h2>
          <button type="button" id="tombol-tulis" class="btn btn-dark !min-h-11">Tulis panduan</button>
        </div>
        <ul id="daftar-panduan" class="mt-3 divide-y divide-line border-y border-line"></ul>
        <p id="panduan-kosong" hidden class="py-5 text-muted">Belum ada panduan. Panduan muncul di menu Panduan dan di beranda.</p>
      </section>

      <details class="mt-8 rounded-2xl bg-card px-4 py-1.5" id="impor">
        <summary class="py-2.5 font-semibold">Tambah banyak produk sekaligus</summary>
        <p class="mt-1 text-sm text-muted">
          Isi produk di Excel atau Google Sheets, satu baris satu produk, lalu salin semua barisnya (termasuk baris judul kolom) dan tempel di bawah. Bisa juga memilih file CSV.{' '}<a class="underline" href="/template-produk.csv" download>Unduh contoh tabel</a>.
        </p>
        <p class="mt-2 text-sm text-muted">
          Wajib diisi: kolom <code>nama</code> dan <code>kategori</code>. Foto ditambahkan sesudahnya lewat tombol Lengkapi.
        </p>
        <p class="mt-1 text-sm text-muted">Kolom lain boleh kosong:</p>
        <ul class="mt-1 flex flex-wrap gap-1.5 text-xs">
          {['koleksi', 'harga', 'terjual', 'badge', 'tag', 'link_shopee', 'keunggulan_1', 'keunggulan_2', 'keunggulan_3', 'kata_istri', 'catatan_suami', 'cocok_untuk', 'perhatikan'].map((name) => (
            <li class="rounded-full bg-paper px-2.5 py-1 font-mono">{name}</li>
          ))}
        </ul>
        <div class="mt-3">
          <label class="field-label" for="impor-teks">Tempel baris dari tabel</label>
          <textarea class="field font-mono" id="impor-teks" rows="5" spellcheck="false"></textarea>
        </div>
        <div class="mt-3 flex flex-wrap items-end gap-2">
          <div>
            <label class="field-label" for="impor-file">Atau pilih file CSV</label>
            <input class="field" id="impor-file" type="file" accept=".csv,text/csv" />
          </div>
          <button type="button" id="impor-jalankan" class="btn btn-dark">Tambahkan ke daftar</button>
        </div>
        <div id="impor-hasil" role="status" class="mt-3 hidden rounded-2xl bg-paper px-4 py-3 text-sm"></div>
        <div class="h-3"></div>
      </details>

      <details class="mt-3 rounded-2xl bg-card px-4 py-1.5" id="banner">
        <summary class="py-2.5 font-semibold">Gambar banner koleksi</summary>
        <p class="mt-1 text-sm text-muted">
          Gambar di sisi kanan banner koleksi. Tanpa gambar khusus, banner memakai foto produk pertama di koleksi itu,
          atau ilustrasi pasangan kalau belum ada. Gambar dipotong persegi dari tengah.
        </p>
        <ul id="daftar-banner" class="mt-3 divide-y divide-line"></ul>
        <div class="h-3"></div>
      </details>

      <details class="mt-3 rounded-2xl bg-card px-4 py-1.5" id="pengaturan">
        <summary class="py-2.5 font-semibold">Sambungan ke GitHub</summary>
        <p class="mt-2 text-sm text-muted">
          Diisi sekali per perangkat. Token disimpan di browser ini saja dan hanya dikirim ke GitHub. Buat token
          “fine-grained” yang hanya berlaku untuk repositori situs ini, dengan izin Contents: Read and write.
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <label class="field-label" for="gh-repo">Repositori</label>
            <input class="field" id="gh-repo" placeholder="nama-akun/nama-repo" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="gh-branch">Branch</label>
            <input class="field" id="gh-branch" placeholder="main" autocomplete="off" />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label" for="gh-token">Token GitHub</label>
            <input class="field" id="gh-token" type="password" autocomplete="off" />
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" id="gh-simpan" class="btn btn-dark">Simpan sambungan</button>
          <button type="button" id="gh-muat" class="btn btn-quiet">Muat daftar terbaru dari GitHub</button>
          <button type="button" id="gh-hapus" class="btn btn-quiet">Hapus token dari perangkat ini</button>
        </div>
        <div class="h-3"></div>
      </details>

      <details class="mt-3 rounded-2xl bg-card px-4 py-1.5">
        <summary class="py-2.5 font-semibold">Tanpa GitHub: buka dan unduh file</summary>
        <p class="mt-2 text-sm text-muted">
          Unduh hasilnya sebagai <code>products.json</code>, lalu unggah sendiri ke folder <code>src/data</code> di
          GitHub. Foto baru diunduh satu per satu dan diunggah ke <code>public/images/products</code>.
        </p>
        <div class="mt-3 flex flex-wrap items-end gap-2">
          <div>
            <label class="field-label" for="file-buka">Buka products.json</label>
            <input class="field" id="file-buka" type="file" accept="application/json,.json" />
          </div>
          <button type="button" id="file-unduh" class="btn btn-quiet">Unduh products.json</button>
        </div>
        <ul id="foto-unduh" class="mt-3 space-y-1 pb-3 text-sm"></ul>
      </details>
    </div>

    <form id="form-produk" hidden novalidate class="mt-5">
      <h2 class="text-xl font-bold" id="judul-form" tabindex="-1">Produk baru</h2>
      <div id="form-galat" role="alert" class="mt-3 hidden rounded-2xl border border-ink px-4 py-3 text-sm"></div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2 rounded-2xl bg-card p-4">
          <label class="field-label" for="f-url-produk">Link halaman produk di Shopee (opsional)</label>
          <input class="field" id="f-url-produk" inputmode="url" placeholder="https://shopee.co.id/Nama-Produk-i.123.456" autocomplete="off" />
          <p class="field-hint" id="f-url-hasil">
            Tempel link panjang dari halaman produk untuk mengisi nama otomatis. Harga, foto, dan jumlah terjual
            tidak bisa diambil otomatis, jadi tetap diisi sendiri.
          </p>
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-nama">Nama produk (wajib)</label>
          <input class="field" id="f-nama" autocomplete="off" />
        </div>
        <div>
          <label class="field-label" for="f-kategori">Kategori (wajib)</label>
          <select class="field" id="f-kategori"></select>
        </div>
        <div>
          <label class="field-label" for="f-harga">Harga (angka saja, yang termurah)</label>
          <input class="field" id="f-harga" inputmode="numeric" placeholder="149000" autocomplete="off" />
          <label class="mt-1 flex min-h-11 items-center gap-2 text-sm">
            <input type="checkbox" id="f-mulai" class="size-5" />
            Ada beberapa pilihan. Tampilkan “Mulai Rp...”
          </label>
          <label class="flex min-h-11 items-center gap-2 text-sm">
            <input type="checkbox" id="f-dicek" class="size-5" />
            Saya baru mengecek harga ini di Shopee
          </label>
          <p class="field-hint" id="f-dicek-ket"></p>
        </div>
        <fieldset class="sm:col-span-2">
          <legend class="field-label">Koleksi</legend>
          <div id="f-koleksi" class="flex flex-wrap gap-x-5 gap-y-1"></div>
        </fieldset>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-link">Link afiliasi Shopee</label>
          <input class="field" id="f-link" inputmode="url" placeholder="https://s.shopee.co.id/..." autocomplete="off" />
          <p class="field-hint">Dari dasbor Shopee Affiliate, menu Link Khusus. Tanpa link ini tombol beli tidak aktif.</p>
        </div>
        <div>
          <label class="field-label" for="f-terjual">Label terjual</label>
          <input class="field" id="f-terjual" placeholder="10RB+ terjual" autocomplete="off" />
        </div>
        <div>
          <label class="field-label" for="f-badge">Label toko</label>
          <select class="field" id="f-badge">
            <option value="">Tidak ada</option>
            <option>Shopee Mall</option>
            <option>Star+</option>
            <option>Star</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-tag">Kalimat pendek</label>
          <input class="field" id="f-tag" placeholder="Anti lengket dan bisa kompor induksi" autocomplete="off" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-foto">Foto produk</label>
          <input class="field" id="f-foto" type="file" accept="image/*" />
          <p class="field-hint">Foto dibuat persegi dan diperkecil otomatis. Kosongkan kalau tidak ingin mengganti foto.</p>
          <img id="f-foto-pratinjau" alt="Pratinjau foto" width="160" height="160" hidden class="tile mt-2 size-40 object-cover" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-k1">Kenapa masuk ListBerdua (sampai tiga poin)</label>
          <input class="field" id="f-k1" aria-label="Poin pertama" autocomplete="off" />
          <input class="field mt-2" id="f-k2" aria-label="Poin kedua" autocomplete="off" />
          <input class="field mt-2" id="f-k3" aria-label="Poin ketiga" autocomplete="off" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-istri">Kata Istri</label>
          <textarea class="field" id="f-istri" rows="3"></textarea>
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-suami">Catatan Suami</label>
          <textarea class="field" id="f-suami" rows="3"></textarea>
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-cocok">Cocok untuk</label>
          <input class="field" id="f-cocok" autocomplete="off" />
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="f-perhatikan">Perlu diperhatikan</label>
          <input class="field" id="f-perhatikan" autocomplete="off" />
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        <button type="submit" class="btn btn-dark">Simpan produk</button>
        <button type="button" id="form-batal" class="btn btn-quiet">Batal</button>
      </div>
    </form>

    <form id="form-panduan" hidden novalidate class="mt-5">
      <h2 class="text-xl font-bold" id="judul-form-panduan" tabindex="-1">Panduan baru</h2>
      <div id="panduan-galat" role="alert" class="mt-3 hidden rounded-2xl border border-ink px-4 py-3 text-sm"></div>
      <div class="mt-4 grid gap-4">
        <div>
          <label class="field-label" for="g-judul">Judul (wajib)</label>
          <input class="field" id="g-judul" autocomplete="off" placeholder="Isi tas lahiran ke RS yang benar-benar kami pakai" />
        </div>
        <div>
          <label class="field-label" for="g-ringkas">Ringkasan satu kalimat (wajib)</label>
          <input class="field" id="g-ringkas" autocomplete="off" />
          <p class="field-hint">Tampil di daftar panduan dan saat link dibagikan.</p>
        </div>
        <div>
          <label class="field-label" for="g-isi">Isi</label>
          <textarea class="field font-[inherit] leading-relaxed" id="g-isi" rows="14"></textarea>
          <ul class="field-hint mt-1 space-y-0.5">
            <li>Baris kosong memisahkan paragraf.</li>
            <li><code>## Judul bagian</code> untuk subjudul, <code>- poin</code> untuk daftar.</li>
            <li>Produk disisipkan dengan tombol di bawah, tampil sebagai kartu produk.</li>
          </ul>
        </div>
        <div class="flex flex-wrap items-end gap-2">
          <div class="min-w-0 flex-1 basis-56">
            <label class="field-label" for="g-produk">Sisipkan produk</label>
            <select class="field" id="g-produk"></select>
          </div>
          <button type="button" id="g-sisip" class="btn btn-quiet">Sisipkan di posisi kursor</button>
        </div>
        <details class="rounded-2xl bg-card px-4 py-1.5" id="g-pratinjau-kotak">
          <summary class="py-2.5 font-semibold">Pratinjau</summary>
          <div id="g-pratinjau" class="pb-4"></div>
        </details>
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        <button type="submit" class="btn btn-dark">Simpan panduan</button>
        <button type="button" id="panduan-batal" class="btn btn-quiet">Batal</button>
      </div>
    </form>
  </section>

  <script type="application/json" id="admin-data" set:html={seedText} />
</Base>

<script>
  import { parseGuide, productSlugsIn, type Guide } from '../lib/guide';

  interface Item {
    id: string;
    slug: string;
    name: string;
    category: string;
    categorySlug: string;
    collection: string[];
    priceEstimate?: string;
    soldLabel?: string;
    storeBadge?: string;
    quickTag?: string;
    image?: string;
    affiliateUrl?: string;
    highlights: string[];
    wifeNote?: string;
    husbandNote?: string;
    bestFor?: string;
    caveat?: string;
    priceCheckedAt?: string;
  }

  const DATA_PATH = 'src/data/products.json';
  const PHOTO_DIR = 'public/images/products';
  const GUIDES_PATH = 'src/data/guides.json';
  // Dates follow Indonesia's western time zone (UTC+7), like the visit counter.
  const today = () => new Date(Date.now() + 7 * 3600e3).toISOString().slice(0, 10);
  const daysSince = (iso: string) => Math.floor((Date.parse(today()) - Date.parse(iso)) / 86400e3);
  const longDate = (iso: string) => new Date(iso + 'T00:00:00').toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

  function setUpAdmin() {
    const root = document.querySelector('#admin');
    if (!root) return;

    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const seed = JSON.parse($('#admin-data').textContent!);
    const categories: { slug: string; name: string }[] = seed.categories;
    let items: Item[] = seed.products;
    let editing: string | null = null;
    let dirty = false;
    let formPhoto: string | null = null;
    // New photos wait here (slug -> JPEG data URL) until they are published or downloaded.
    const photos = new Map<string, string>();
    // New collection banners (collection slug -> JPEG data URL), published with the photos.
    const banners = new Map<string, string>();
    const BANNER_DIR = 'public/images/koleksi';

    const message = $('#admin-pesan');
    function say(text: string) {
      message.textContent = text;
      message.classList.toggle('hidden', !text);
    }

    // ---- GitHub connection, kept in this browser only
    const repoInput = $<HTMLInputElement>('#gh-repo');
    const branchInput = $<HTMLInputElement>('#gh-branch');
    const tokenInput = $<HTMLInputElement>('#gh-token');
    function loadSettings() {
      try {
        const saved = JSON.parse(localStorage.getItem('lb-admin') ?? '{}');
        repoInput.value = saved.repo ?? '';
        branchInput.value = saved.branch ?? 'main';
        tokenInput.value = saved.token ?? '';
      } catch {
        branchInput.value = 'main';
      }
    }
    const settings = () => ({
      repo: repoInput.value.trim(),
      branch: branchInput.value.trim() || 'main',
      token: tokenInput.value.trim(),
    });

    async function github(path: string, init?: RequestInit) {
      const { repo, token } = settings();
      const res = await fetch(`https://api.github.com/repos/${repo}/contents/${path}`, {
        ...init,
        // GitHub lets browsers reuse a read for 60 seconds; a stale read means a stale sha and a refused save.
        cache: 'no-store',
        headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json' },
      });
      if (res.status === 404 && (!init || init.method === 'GET')) return null;
      if (!res.ok) {
        const reason =
          res.status === 401 ? 'Token salah atau sudah kedaluwarsa.'
          : res.status === 403 ? 'Token tidak punya izin Contents: Read and write untuk repositori ini.'
          : res.status === 404 ? 'Repositori atau branch tidak ditemukan.'
          : res.status === 409 ? 'File berubah di GitHub saat disimpan. Muat daftar terbaru, lalu coba lagi.'
          : `GitHub menjawab ${res.status}.`;
        throw Object.assign(new Error(reason), { status: res.status });
      }
      return res.json();
    }

    const toBase64 = (text: string) => {
      const bytes = new TextEncoder().encode(text);
      let binary = '';
      bytes.forEach((b) => (binary += String.fromCharCode(b)));
      return btoa(binary);
    };
    const fromBase64 = (b64: string) =>
      new TextDecoder().decode(Uint8Array.from(atob(b64.replace(/\s/g, '')), (c) => c.charCodeAt(0)));

    async function putFile(path: string, contentBase64: string, commitMessage: string) {
      const { branch } = settings();
      // GitHub answers 409 when the branch moved a moment ago (for example right after a photo upload).
      for (let attempt = 1; ; attempt++) {
        const existing = await github(`${path}?ref=${encodeURIComponent(branch)}`);
        try {
          await github(path, {
            method: 'PUT',
            body: JSON.stringify({ message: commitMessage, content: contentBase64, branch, ...(existing ? { sha: existing.sha } : {}) }),
          });
          return;
        } catch (error) {
          if ((error as { status?: number }).status !== 409 || attempt === 4) throw error;
          await new Promise((resolve) => setTimeout(resolve, attempt * 1500));
        }
      }
    }

    // ---- list
    const list = $('#daftar-admin');
    const status = $('#status-ubah');
    function setDirty(value: boolean) {
      dirty = value;
      status.textContent = dirty ? 'Ada perubahan yang belum dipublikasikan.' : '';
      renderSummary();
    }

    // What each product still lacks before it is worth showing to buyers.
    function gaps(item: Item): string[] {
      const missing: string[] = [];
      if (!item.image && !photos.has(item.slug)) missing.push('foto');
      if (!item.affiliateUrl || item.affiliateUrl.includes('CONTOH_LINK')) missing.push('link Shopee');
      if (!item.priceEstimate) missing.push('harga');
      if (!item.wifeNote) missing.push('Kata Istri');
      if (!item.husbandNote) missing.push('Catatan Suami');
      return missing;
    }

    const filterText = $<HTMLInputElement>('#saring-teks');
    const filterCategory = $<HTMLSelectElement>('#saring-kategori');
    filterCategory.append(
      ...categories.map((c) => Object.assign(document.createElement('option'), { value: c.slug, textContent: c.name })),
    );
    filterText.addEventListener('input', () => renderList());
    filterCategory.addEventListener('change', () => renderList());

    function renderSummary() {
      const incomplete = items.filter((item) => gaps(item).length > 0);
      $('#ringkasan-baris').textContent =
        `${items.length} produk, ${items.length - incomplete.length} sudah lengkap, ${incomplete.length} perlu dilengkapi.`;

      const todo = $('#daftar-lengkapi');
      todo.replaceChildren(
        ...incomplete.map((item) => {
          const li = document.createElement('li');
          li.className = 'flex flex-wrap items-center gap-x-3 gap-y-1 py-2.5';
          const text = document.createElement('div');
          text.className = 'min-w-0 flex-1 basis-48';
          text.append(
            Object.assign(document.createElement('p'), { className: 'font-semibold', textContent: item.name }),
            Object.assign(document.createElement('p'), { className: 'text-sm text-muted', textContent: `Belum ada: ${gaps(item).join(', ')}` }),
          );
          const fix = document.createElement('button');
          fix.type = 'button';
          fix.className = 'btn btn-dark !min-h-11 !px-4 text-sm';
          fix.textContent = 'Lengkapi';
          fix.setAttribute('aria-label', `Lengkapi ${item.name}`);
          fix.addEventListener('click', () => openForm(item.slug));
          li.append(text, fix);
          return li;
        }),
      );
      $('#lengkapi-kosong').hidden = incomplete.length > 0 || items.length === 0;

      const stale = items.filter((item) => item.priceEstimate && (!item.priceCheckedAt || daysSince(item.priceCheckedAt) > 30));
      $('#daftar-harga').replaceChildren(
        ...stale.map((item) => {
          const li = document.createElement('li');
          li.className = 'flex flex-wrap items-center gap-x-3 gap-y-2 py-2.5';
          const text = document.createElement('div');
          text.className = 'min-w-0 flex-1 basis-48';
          text.append(
            Object.assign(document.createElement('p'), { className: 'font-semibold', textContent: item.name }),
            Object.assign(document.createElement('p'), {
              className: 'text-sm text-muted',
              textContent: `${item.priceEstimate} · ${item.priceCheckedAt ? `dicek ${daysSince(item.priceCheckedAt)} hari lalu` : 'belum pernah dicek'}`,
            }),
          );
          const same = document.createElement('button');
          same.type = 'button';
          same.className = 'btn btn-quiet !min-h-11 !px-4 text-sm';
          same.textContent = 'Harga masih sama';
          same.setAttribute('aria-label', `Harga ${item.name} masih sama`);
          same.addEventListener('click', () => {
            item.priceCheckedAt = today();
            setDirty(true);
            renderList();
            say(`Harga “${item.name}” ditandai sudah dicek hari ini. Ketuk “Publikasikan ke situs” supaya tanggalnya tampil.`);
          });
          const change = document.createElement('button');
          change.type = 'button';
          change.className = 'btn btn-dark !min-h-11 !px-4 text-sm';
          change.textContent = 'Ubah harga';
          change.setAttribute('aria-label', `Ubah harga ${item.name}`);
          change.addEventListener('click', () => {
            openForm(item.slug);
            field('dicek').checked = true;
            field('harga').focus();
          });
          const actions = document.createElement('div');
          actions.className = 'flex gap-1.5';
          actions.append(same, change);
          li.append(text, actions);
          return li;
        }),
      );
      $('#harga-kosong').hidden = stale.length > 0 || items.length === 0;

      const site: string[] = [];
      site.push(seed.sampleMode
        ? 'Mode contoh masih menyala: pita peringatan tampil dan Google tidak mengindeks situs. Matikan di src/data/site.ts (sampleMode: false) setelah semua produk asli.'
        : 'Mode contoh sudah mati. Situs tampil normal dan boleh diindeks Google.');
      site.push(seed.hasContact ? 'Email kontak sudah diisi.' : 'Email kontak belum diisi (contactEmail di src/data/site.ts).');
      site.push(dirty ? 'Ada perubahan di halaman ini yang belum dipublikasikan.' : 'Tidak ada perubahan yang menunggu dipublikasikan.');
      $('#daftar-situs').replaceChildren(...site.map((line) => Object.assign(document.createElement('li'), { textContent: line })));

      $('#tabel-kategori').replaceChildren(
        ...categories.map((c) => {
          const row = document.createElement('tr');
          row.className = 'border-t border-line first:border-0';
          const count = items.filter((item) => item.categorySlug === c.slug).length;
          row.append(
            Object.assign(document.createElement('th'), { scope: 'row', className: 'py-1.5 text-left font-normal', textContent: c.name }),
            Object.assign(document.createElement('td'), { className: 'py-1.5 text-right font-semibold tabular-nums', textContent: count === 0 ? 'kosong' : String(count) }),
          );
          return row;
        }),
      );
    }

    function renderList() {
      list.replaceChildren();
      renderSummary();
      const words = filterText.value.toLowerCase().trim();
      const filtering = Boolean(words || filterCategory.value);
      let shown = 0;
      items.forEach((item, index) => {
        if (words && !item.name.toLowerCase().includes(words)) return;
        if (filterCategory.value && item.categorySlug !== filterCategory.value) return;
        shown++;
        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-center gap-x-3 gap-y-2 py-3';
        const thumbSrc = photos.get(item.slug) ?? item.image;
        const thumb = document.createElement(thumbSrc ? 'img' : 'div');
        thumb.className = 'tile size-14 shrink-0 !rounded-xl object-cover';
        if (thumb instanceof HTMLImageElement) {
          thumb.src = thumbSrc!;
          thumb.alt = '';
          thumb.width = thumb.height = 56;
          thumb.loading = 'lazy';
          // A photo that is not on the site yet leaves the plain grey tile instead of a broken image.
          thumb.addEventListener('error', () => thumb.removeAttribute('src'));
        }
        li.append(thumb);
        const text = document.createElement('div');
        text.className = 'min-w-0 flex-1 basis-56';
        const name = document.createElement('p');
        name.className = 'font-semibold';
        name.textContent = item.name;
        const meta = document.createElement('p');
        meta.className = 'text-sm text-muted';
        meta.textContent = [item.category, item.priceEstimate, photos.has(item.slug) ? 'foto baru' : ''].filter(Boolean).join(' · ');
        text.append(name, meta);

        const actions = document.createElement('div');
        actions.className = 'flex gap-1.5';
        const make = (label: string, aria: string, run: () => void, disabled = false) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'btn btn-quiet !min-h-11 !px-4 text-sm';
          b.textContent = label;
          b.setAttribute('aria-label', `${aria} ${item.name}`);
          b.disabled = disabled;
          b.addEventListener('click', run);
          return b;
        };
        // Reordering a filtered list would move items past ones that are hidden.
        actions.append(
          make('Naik', 'Naikkan urutan', () => move(index, -1), filtering || index === 0),
          make('Turun', 'Turunkan urutan', () => move(index, 1), filtering || index === items.length - 1),
          make('Ubah', 'Ubah', () => openForm(item.slug)),
          make('Hapus', 'Hapus', () => remove(item.slug)),
        );
        li.append(text, actions);
        list.append(li);
      });
      $('#daftar-kosong').hidden = items.length > 0;
      $('#saring-kosong').hidden = items.length === 0 || shown > 0;
      renderPhotoDownloads();
    }

    function move(index: number, by: number) {
      const [item] = items.splice(index, 1);
      items.splice(index + by, 0, item);
      setDirty(true);
      renderList();
    }

    function remove(slug: string) {
      const item = items.find((i) => i.slug === slug)!;
      if (!confirm(`Hapus “${item.name}” dari daftar?`)) return;
      items = items.filter((i) => i.slug !== slug);
      photos.delete(slug);
      setDirty(true);
      renderList();
    }

    function renderPhotoDownloads() {
      const box = $('#foto-unduh');
      box.replaceChildren();
      if (guidesChanged) {
        const li = document.createElement('li');
        const a = Object.assign(document.createElement('a'), {
          href: URL.createObjectURL(new Blob([JSON.stringify(guides, null, 2) + '\n'], { type: 'application/json' })),
          download: 'guides.json',
          className: 'underline',
        });
        a.textContent = 'Unduh guides.json (unggah ke src/data)';
        li.append(a);
        box.append(li);
      }
      banners.forEach((dataUrl, slug) => {
        const li = document.createElement('li');
        const a = Object.assign(document.createElement('a'), { href: dataUrl, download: `${slug}.jpg`, className: 'underline' });
        a.textContent = `Unduh banner ${slug}.jpg (unggah ke public/images/koleksi)`;
        li.append(a);
        box.append(li);
      });
      photos.forEach((dataUrl, slug) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `${slug}.jpg`;
        a.className = 'underline';
        a.textContent = `Unduh foto ${slug}.jpg`;
        li.append(a);
        box.append(li);
      });
    }

    // ---- form
    const form = $<HTMLFormElement>('#form-produk');
    const listView = $('#tampilan-daftar');
    const field = (id: string) => $<HTMLInputElement>(`#f-${id}`);
    const categorySelect = $<HTMLSelectElement>('#f-kategori');
    const collectionBox = $('#f-koleksi');
    const preview = $<HTMLImageElement>('#f-foto-pratinjau');
    const errors = $('#form-galat');

    categorySelect.replaceChildren(
      ...categories.map((c) => {
        const o = document.createElement('option');
        o.value = c.slug;
        o.textContent = c.name;
        return o;
      }),
    );
    collectionBox.replaceChildren(
      ...(seed.collections as string[]).map((name, i) => {
        const label = document.createElement('label');
        label.className = 'flex min-h-11 items-center gap-2';
        const box = document.createElement('input');
        box.type = 'checkbox';
        box.value = name;
        box.id = `f-kol-${i}`;
        box.className = 'size-5';
        label.append(box, name);
        return label;
      }),
    );

    const slugify = (text: string) =>
      text.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 70);

    function openForm(slug: string | null) {
      editing = slug;
      const item = slug ? items.find((i) => i.slug === slug) : undefined;
      $('#judul-form').textContent = item ? `Ubah: ${item.name}` : 'Produk baru';
      field('nama').value = item?.name ?? '';
      categorySelect.value = item?.categorySlug ?? categories[0].slug;
      field('harga').value = (item?.priceEstimate ?? '').replace(/\D/g, '');
      field('mulai').checked = /^mulai/i.test(item?.priceEstimate ?? '');
      field('dicek').checked = !item;
      $('#f-dicek-ket').textContent = item?.priceCheckedAt ? `Terakhir dicek ${longDate(item.priceCheckedAt)}. Kalau harganya diubah, tanggal ini ikut diperbarui.` : 'Tanggal cek tampil di halaman produk supaya pembeli tahu harganya masih baru.';
      field('link').value = item?.affiliateUrl ?? '';
      field('terjual').value = item?.soldLabel ?? '';
      $<HTMLSelectElement>('#f-badge').value = item?.storeBadge ?? '';
      field('tag').value = item?.quickTag ?? '';
      [1, 2, 3].forEach((n) => (field(`k${n}`).value = item?.highlights?.[n - 1] ?? ''));
      $<HTMLTextAreaElement>('#f-istri').value = item?.wifeNote ?? '';
      $<HTMLTextAreaElement>('#f-suami').value = item?.husbandNote ?? '';
      field('cocok').value = item?.bestFor ?? '';
      field('perhatikan').value = item?.caveat ?? '';
      collectionBox.querySelectorAll<HTMLInputElement>('input').forEach((box) => (box.checked = item?.collection?.includes(box.value) ?? false));
      field('foto').value = '';
      field('url-produk').value = '';
      urlHint.textContent = urlHintDefault;
      formPhoto = null;
      const current = slug ? (photos.get(slug) ?? item?.image) : null;
      preview.hidden = !current;
      if (current) preview.src = current;
      errors.classList.add('hidden');
      listView.hidden = true;
      form.hidden = false;
      say('');
      $('#judul-form').focus();
    }

    function closeForm() {
      form.hidden = true;
      listView.hidden = false;
      $('#judul-admin-daftar').focus();
    }

    // Shopee product URLs carry the product name as "Nama-Produk-i.<shop>.<item>"; nothing is fetched.
    const urlHint = $('#f-url-hasil');
    const urlHintDefault = urlHint.textContent!;
    field('url-produk').addEventListener('input', () => {
      const raw = field('url-produk').value.trim();
      if (!raw) return void (urlHint.textContent = urlHintDefault);
      let name = '';
      try {
        const url = new URL(raw);
        const match = /^\/(.+)-i\.\d+\.\d+/.exec(url.pathname);
        if (/(^|\.)shopee\.co\.id$/.test(url.hostname) && match) name = decodeURIComponent(match[1]).replace(/-+/g, ' ').trim();
      } catch {
        name = '';
      }
      if (!name) {
        urlHint.textContent = 'Nama tidak ditemukan di link itu. Link pendek (s.shopee.co.id) tidak memuat nama: buka produknya di browser, lalu salin link dari kolom alamat.';
        return;
      }
      field('nama').value = name;
      urlHint.textContent = 'Nama diisi dari link. Periksa dan rapikan kalau perlu.';
    });

    // Photos become a 1000px white square so every tile on the site lines up.
    field('foto').addEventListener('change', async () => {
      const file = field('foto').files?.[0];
      if (!file) return;
      try {
        const bitmap = await createImageBitmap(file);
        const size = 1000;
        const canvas = document.createElement('canvas');
        canvas.width = canvas.height = size;
        const ctx = canvas.getContext('2d')!;
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, size, size);
        const scale = Math.min(size / bitmap.width, size / bitmap.height);
        const w = bitmap.width * scale;
        const h = bitmap.height * scale;
        ctx.drawImage(bitmap, (size - w) / 2, (size - h) / 2, w, h);
        formPhoto = canvas.toDataURL('image/jpeg', 0.85);
        preview.src = formPhoto;
        preview.hidden = false;
      } catch {
        formPhoto = null;
        errors.textContent = 'Foto itu tidak bisa dibaca. Coba file JPG atau PNG lain.';
        errors.classList.remove('hidden');
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = field('nama').value.trim();
      const link = field('link').value.trim();
      const price = field('harga').value.replace(/\D/g, '');
      const problems: string[] = [];
      if (!name) problems.push('Nama produk belum diisi.');
      let slug = editing ?? slugify(name);
      if (name && !slug) problems.push('Nama produk harus mengandung huruf atau angka.');
      if (!editing && items.some((i) => i.slug === slug)) problems.push('Sudah ada produk dengan nama yang sama. Ubah sedikit namanya.');
      if (link && !isShopeeLink(link)) {
        problems.push('Link harus diawali https:// dan beralamat shopee.co.id atau shope.ee.');
      }
      if (problems.length) {
        errors.replaceChildren(...problems.map((p) => Object.assign(document.createElement('p'), { textContent: p })));
        errors.classList.remove('hidden');
        errors.scrollIntoView({ block: 'center' });
        return;
      }

      const category = categories.find((c) => c.slug === categorySelect.value)!;
      const previous = editing ? items.find((i) => i.slug === editing) : undefined;
      if (formPhoto) photos.set(slug, formPhoto);
      const item: Item = {
        id: slug,
        slug,
        name,
        category: category.name,
        categorySlug: category.slug,
        collection: [...collectionBox.querySelectorAll<HTMLInputElement>('input:checked')].map((b) => b.value),
        priceEstimate: price ? (field('mulai').checked ? 'Mulai ' : '') + 'Rp' + Number(price).toLocaleString('id-ID') : '',
        soldLabel: field('terjual').value.trim(),
        storeBadge: $<HTMLSelectElement>('#f-badge').value,
        quickTag: field('tag').value.trim(),
        image: formPhoto ? `/images/products/${slug}.jpg` : (previous?.image ?? ''),
        affiliateUrl: link,
        highlights: [1, 2, 3].map((n) => field(`k${n}`).value.trim()).filter(Boolean),
        wifeNote: $<HTMLTextAreaElement>('#f-istri').value.trim(),
        husbandNote: $<HTMLTextAreaElement>('#f-suami').value.trim(),
        bestFor: field('cocok').value.trim(),
        caveat: field('perhatikan').value.trim(),
        // A new or changed price, or a confirmed check, stamps today's date.
        priceCheckedAt: !price ? '' : field('dicek').checked || price !== (previous?.priceEstimate ?? '').replace(/\D/g, '') ? today() : (previous?.priceCheckedAt ?? ''),
      };
      // Empty fields are dropped so the product page hides those parts.
      (Object.keys(item) as (keyof Item)[]).forEach((key) => {
        if (item[key] === '') delete item[key];
      });

      if (previous) items[items.indexOf(previous)] = item;
      else items.push(item);
      setDirty(true);
      renderList();
      closeForm();
      say(`“${name}” disimpan di daftar. Ketuk “Publikasikan ke situs” supaya tampil.`);
