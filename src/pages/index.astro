---
import Base from '../layouts/Base.astro';
import CategoryPills from '../components/CategoryPills.astro';
import HeroBanners from '../components/HeroBanners.astro';
import ProductBrowser from '../components/ProductBrowser.astro';
import ProductCard from '../components/ProductCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { products } from '../lib/catalog';
import { guides } from '../lib/guides';

// Newest first, only products that carry the date they were added.
const newest = products
  .filter((p) => p.addedAt)
  .sort((a, b) => b.addedAt!.localeCompare(a.addedAt!))
  .slice(0, 8);
---

<Base>
  <div class="wrap pt-3" data-ringkas-saat-cari>
    <HeroBanners />
  </div>

  <section class="mt-5" aria-labelledby="judul-kategori">
    <h2 id="judul-kategori" class="wrap mb-2 text-xl font-bold">Kategori</h2>
    <CategoryPills />
  </section>

  {
    newest.length >= 2 && (
      <section class="wrap mt-8" aria-labelledby="judul-baru" data-sembunyi-saat-cari>
        <h2 id="judul-baru" class="mb-3 text-xl font-bold">Baru kami tambahkan</h2>
        <ul class="pill-row -mx-4 flex snap-x gap-3 overflow-x-auto px-4 pb-1 md:mx-0 md:grid md:grid-cols-4 md:overflow-visible md:px-0">
          {newest.map((p) => <ProductCard product={p} inRow class="w-[44%] shrink-0 snap-start md:w-auto" />)}
        </ul>
      </section>
    )
  }

  <section class="wrap mt-9" aria-labelledby="judul-daftar">
    {
      products.length === 0 ? (
        <>
          <h2 id="judul-daftar" class="text-xl font-bold">Semua pilihan</h2>
          <p class="py-8 text-muted">Belum ada barang. Tambahkan produk dari dasbor.</p>
        </>
      ) : (
        <ProductBrowser products={products} title="Semua pilihan" headingId="judul-daftar" statusId="status-cari" />
      )
    }

    <div id="cari-kosong" hidden class="max-w-md py-8">
      <p class="font-medium">Tidak ada barang yang cocok.</p>
      <p class="mt-1 text-muted">Coba kata yang lebih pendek, misalnya “rak” atau “bayi”, atau lihat semua pilihan lagi.</p>
      <button type="button" id="hapus-cari" class="btn btn-dark mt-4">Lihat semua pilihan</button>
    </div>
  </section>

  {
    guides.length > 0 && (
      <section class="wrap mt-12" aria-labelledby="judul-panduan" data-sembunyi-saat-cari>
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4">
          <h2 id="judul-panduan" class="text-xl font-bold">Panduan dari kami</h2>
          <a href="/panduan/" class="inline-flex min-h-11 items-center text-sm text-muted hover:text-ink hover:underline">Lihat semua panduan</a>
        </div>
        <ul class="grid gap-3 md:grid-cols-2">
          {guides.slice(0, 2).map((guide) => <GuideCard guide={guide} />)}
        </ul>
      </section>
    )
  }
</Base>

<script>
  function setUpSearch() {
    const intro = document.querySelector<HTMLElement>('[data-ringkas-saat-cari]');
    // Only the home page has the full list to filter.
    if (!intro) return;

    const input = document.querySelector<HTMLInputElement>('#cari')!;
    const form = document.querySelector<HTMLFormElement>('#form-cari')!;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-cari]')];
    const grid = document.querySelector<HTMLElement>('#judul-daftar')?.closest('section')?.querySelector<HTMLElement>('.kisi-produk');
    const hideWhileSearching = document.querySelectorAll<HTMLElement>('[data-sembunyi-saat-cari]');
    const heading = document.querySelector<HTMLElement>('#judul-daftar')!;
    const status = document.querySelector<HTMLElement>('#status-cari')!;
    const empty = document.querySelector<HTMLElement>('#cari-kosong')!;
    const total = cards.length;

    function filter(query: string) {
      const words = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const text = card.dataset.cari ?? '';
        const match = words.every((w) => text.includes(w));
        card.hidden = !match;
        // A card still waiting for its scroll animation would stay invisible in the results.
        if (match) card.classList.remove('reveal-wait');
        if (match) shown++;
      }
      const searching = words.length > 0;
      // While searching every match shows; paging and the price filter's page limit step aside.
      grid?.classList.toggle('tampil-semua', searching);
      grid?.dispatchEvent(new Event('kisi-ubah'));
      hideWhileSearching.forEach((el) => (el.hidden = searching));
      // The h1 stays in the page for screen readers while results take the screen.
      intro!.classList.toggle('sr-only', searching);
      heading.textContent = searching ? `Hasil untuk “${query.trim()}”` : 'Semua pilihan';
      status.textContent = searching ? `${shown} dari ${total} barang cocok` : `${total} barang`;
      empty.hidden = !searching || shown > 0;

      const url = new URL(location.href);
      if (searching) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      history.replaceState(history.state, '', url);
    }

    // On the home page the search filters in place instead of reloading.
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      filter(input.value);
      heading.focus();
    });
    input.addEventListener('input', () => filter(input.value));
    document.querySelector('#hapus-cari')!.addEventListener('click', () => {
      input.value = '';
      filter('');
      input.focus();
    });

    const initial = new URLSearchParams(location.search).get('q') ?? '';
    if (initial) {
      input.value = initial;
      filter(initial);
    }
  }

  // Runs on first load and again each time the router swaps in the home page.
  document.addEventListener('astro:page-load', setUpSearch);
</script>
