---
import Base from '../../layouts/Base.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { byCollection, imageOf } from '../../lib/catalog';
import { collections, site } from '../../data/site';

export function getStaticPaths() {
  return collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

const { collection } = Astro.props;
const items = byCollection(collection.name);
// The preview picture when the link is shared: the uploaded banner, else the first product photo.
const banner = `/images/koleksi/${collection.slug}.jpg`;
const shareImage = existsSync(join(process.cwd(), 'public', banner)) ? banner : (items.map(imageOf).find(Boolean) ?? null);
---

<Base title={collection.name} description={collection.blurb} image={shareImage}>
  <section class="wrap pt-4">
    <nav aria-label="Jejak halaman" class="text-sm text-muted">
      <a href="/" class="inline-flex min-h-11 items-center hover:underline">Beranda</a>
      <span aria-hidden="true" class="px-1">/</span>
      <span>Koleksi</span>
    </nav>
    <h1 class="text-3xl font-bold sm:text-4xl">{collection.name}</h1>
    <p class="mt-1 max-w-[52ch] text-muted">{collection.blurb}</p>

    {
      items.length > 0 ? (
        <>
          <div class="cek-daftar mt-6 rounded-[1.5rem] bg-card p-4 sm:p-5" data-koleksi={collection.slug} data-judul={collection.name} data-link={new URL(`/koleksi/${collection.slug}/`, site.url).href}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="font-bold">Checklist kamu</h2>
              <p class="text-sm text-muted tabular-nums" data-cek-angka role="status">Sudah punya 0 dari {items.length}</p>
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-line" aria-hidden="true">
              <div class="h-full w-0 rounded-full bg-ink transition-[width] duration-500 ease-out" data-cek-bar></div>
            </div>
            <p class="mt-2 text-sm text-muted">Ketuk “Sudah punya” di bawah barang yang sudah kamu beli. Tersimpan di HP ini saja.</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href="#" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-full bg-ink px-4 text-sm font-semibold text-white no-underline hover:bg-[#3b4047]" data-cek-kirim>
                Kirim daftar yang belum dibeli
              </a>
              <button type="button" class="inline-flex min-h-11 items-center rounded-full bg-paper px-4 text-sm font-semibold hover:bg-line" data-cek-hapus hidden>
                Hapus semua centang
              </button>
            </div>
          </div>
          <h2 class="mb-3 mt-6 text-sm font-normal text-muted">{items.length} barang</h2>
          <ProductGrid products={items} checklist />
          <div class="mt-10 border-t border-line pt-6">
            <ShareButtons path={`/koleksi/${collection.slug}/`} title={collection.name} />
          </div>
        </>
      ) : (
        <div class="max-w-md py-8">
          <p class="font-semibold">Koleksi ini masih kosong.</p>
          <p class="mt-1 text-muted">Barangnya sedang kami pilih. Sementara itu, lihat pilihan lain.</p>
          <a href="/" class="btn btn-dark mt-4">Lihat semua pilihan</a>
        </div>
      )
    }
  </section>
</Base>

<script>
  // Checklist per collection, kept in this browser (localStorage key lb-cek-<collection>).
  function setUpChecklist() {
    const box = document.querySelector<HTMLElement>('.cek-daftar');
    if (!box || box.dataset.siap) return;
    box.dataset.siap = '1';
    const key = `lb-cek-${box.dataset.koleksi}`;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-cek]')];
    const read = (): string[] => {
      try {
        const saved = JSON.parse(localStorage.getItem(key) ?? '[]');
        return Array.isArray(saved) ? saved : [];
      } catch {
        return [];
      }
    };
    let done = read();

    function paint() {
      buttons.forEach((b) => {
        const on = done.includes(b.dataset.cek!);
        b.setAttribute('aria-pressed', String(on));
        b.querySelector('.cek-teks')!.textContent = on ? 'Sudah punya' : 'Tandai sudah punya';
        b.closest('li')!.classList.toggle('sudah-punya', on);
      });
      const count = buttons.filter((b) => done.includes(b.dataset.cek!)).length;
      box!.querySelector('[data-cek-angka]')!.textContent = count === buttons.length ? `Lengkap: ${count} dari ${buttons.length} sudah punya` : `Sudah punya ${count} dari ${buttons.length}`;
      box!.querySelector<HTMLElement>('[data-cek-bar]')!.style.width = `${(count / buttons.length) * 100}%`;
      box!.querySelector<HTMLElement>('[data-cek-hapus]')!.hidden = count === 0;
      const missing = buttons
        .filter((b) => !done.includes(b.dataset.cek!))
        .map((b) => `- ${b.closest('li')!.querySelector('h3')!.textContent!.trim()}`);
      const text = missing.length
        ? `${box!.dataset.judul}, yang belum dibeli:\n${missing.join('\n')}\n\n${box!.dataset.link}?src=wa`
        : `${box!.dataset.judul}: semua sudah dibeli.\n${box!.dataset.link}?src=wa`;
      box!.querySelector<HTMLAnchorElement>('[data-cek-kirim]')!.href = `https://wa.me/?text=${encodeURIComponent(text)}`;
    }
    function save() {
      try {
        localStorage.setItem(key, JSON.stringify(done));
      } catch {
        // Private mode: the ticks last for this visit only.
      }
    }
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const slug = b.dataset.cek!;
        done = done.includes(slug) ? done.filter((s) => s !== slug) : [...done, slug];
        save();
        paint();
      }),
    );
    box.querySelector('[data-cek-hapus]')!.addEventListener('click', () => {
      if (!confirm('Hapus semua centang di koleksi ini?')) return;
      done = [];
      save();
      paint();
    });
    paint();
  }
  document.addEventListener('astro:page-load', setUpChecklist);
</script>
