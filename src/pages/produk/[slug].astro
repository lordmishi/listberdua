---
import Base from '../../layouts/Base.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import {
  products,
  byCategory,
  categoryOf,
  collectionsOf,
  imageOf,
  affiliateLinkOf,
  priceNumber,
} from '../../lib/catalog';
import { site } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const category = categoryOf(product);
const inCollections = collectionsOf(product);
const link = affiliateLinkOf(product);
const image = imageOf(product);
const price = priceNumber(product);
const related = byCategory(product.categorySlug)
  .filter((p) => p.slug !== product.slug)
  .slice(0, 4);

const description = [product.quickTag, product.bestFor].filter(Boolean).join('. ') || undefined;

// Structured data needs live mode, a real link, and a single clean price.
const jsonLd =
  !site.sampleMode && link && price
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: product.name,
        ...(description ? { description } : {}),
        category: product.category,
        ...(image ? { image: new URL(image, site.url).href } : {}),
        offers: {
          '@type': 'Offer',
          url: new URL(Astro.url.pathname, site.url).href,
          priceCurrency: 'IDR',
          price,
        },
      }
    : null;
---

<Base title={product.name} description={description} image={image} jsonLd={jsonLd} reserveBottomBar>
  <article class="wrap md:pt-3">
    <nav aria-label="Jejak halaman" class="hidden text-sm text-muted md:block">
      <a href="/" class="inline-flex min-h-11 items-center hover:underline">Beranda</a>
      {
        category && (
          <>
            <span aria-hidden="true" class="px-1">/</span>
            <a href={`/kategori/${category.slug}/`} class="inline-flex min-h-11 items-center hover:underline">
              {category.name}
            </a>
          </>
        )
      }
    </nav>

    <div class="grid gap-5 md:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] md:gap-10">
      <div class="relative -mx-4 overflow-hidden rounded-b-[2rem] bg-panel md:sticky md:top-20 md:mx-0 md:self-start md:rounded-[2rem]">
        <ProductImage product={product} priority onPanel />
        <a
          href={category ? `/kategori/${category.slug}/` : '/'}
          aria-label={category ? `Kembali ke ${category.name}` : 'Kembali ke beranda'}
          class="absolute left-4 top-4 flex size-11 items-center justify-center rounded-full bg-white text-ink transition-transform hover:bg-card active:scale-95 md:hidden"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m14.5 6-6 6 6 6" />
          </svg>
        </a>
        <FavoriteButton slug={product.slug} name={product.name} class="absolute right-4 top-4 !bg-transparent" />
      </div>

      <div class="min-w-0">
        {
          (product.storeBadge || product.soldLabel) && (
            <ul class="flex flex-wrap gap-2">
              {product.storeBadge && <li class="chip">{product.storeBadge}</li>}
              {product.soldLabel && <li class="chip">{product.soldLabel}</li>}
            </ul>
          )
        }

        <div class="mt-4 flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
          <h1 class="max-w-[20ch] text-[1.7rem] font-bold sm:text-4xl">{product.name}</h1>
          <p class="text-[1.7rem] font-bold leading-none tracking-tight sm:pt-1 sm:text-3xl">{product.priceEstimate}</p>
        </div>
        {product.quickTag && <p class="mt-2 text-muted">{product.quickTag}</p>}

        <div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-paper px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 md:static md:mt-6 md:border-0 md:bg-transparent md:p-0">
          {
            link ? (
              <a href={link} target="_blank" rel="sponsored noopener noreferrer" data-klik={product.slug} class="btn btn-dark w-full md:max-w-sm">
                Buka di Aplikasi Shopee
              </a>
            ) : (
              <p class="notice-off w-full md:max-w-sm">Link Shopee belum diisi</p>
            )
          }
        </div>
        <p class="mt-4 max-w-[52ch] text-sm text-muted">
          Harga di atas adalah perkiraan saat kami mencatatnya. Harga dan stok di Shopee dapat berubah sewaktu-waktu.
          Cek detail terbaru sebelum checkout.
        </p>

        {
          product.highlights?.length > 0 && (
            <section class="mt-9" aria-labelledby="judul-kenapa">
              <h2 id="judul-kenapa" class="text-xl font-bold">Kenapa Masuk ListBerdua</h2>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-muted">
                {product.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </section>
          )
        }

        {
          (product.wifeNote || product.husbandNote) && (
            <section class="mt-9 grid gap-3 lg:grid-cols-2" aria-label="Catatan suami dan istri">
              {
                product.wifeNote && (
                  <div class="tile p-5">
                    <h2 class="text-base font-bold">Kata Istri</h2>
                    <p class="mt-2">{product.wifeNote}</p>
                  </div>
                )
              }
              {
                product.husbandNote && (
                  <div class="rounded-[1.5rem] bg-panel p-5 text-white">
                    <h2 class="text-base font-bold">Catatan Suami</h2>
                    <p class="mt-2">{product.husbandNote}</p>
                  </div>
                )
              }
            </section>
          )
        }

        {
          (product.bestFor || product.caveat) && (
            <section class="mt-9" aria-labelledby="judul-cocok">
              <h2 id="judul-cocok" class="text-xl font-bold">Cocok Untuk & Catatan</h2>
              <dl class="mt-2 divide-y divide-line">
                {
                  product.bestFor && (
                    <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
                      <dt class="font-semibold">Cocok untuk</dt>
                      <dd class="text-muted">{product.bestFor}</dd>
                    </div>
                  )
                }
                {
                  product.caveat && (
                    <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
                      <dt class="font-semibold">Perlu diperhatikan</dt>
                      <dd class="text-muted">{product.caveat}</dd>
                    </div>
                  )
                }
              </dl>
            </section>
          )
        }

        {
          inCollections.length > 0 && (
            <p class="mt-6 text-sm text-muted">
              Ada di koleksi:{' '}
              {inCollections.map((c, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/koleksi/${c.slug}/`} class="font-medium text-ink underline hover:decoration-2">
                    {c.name}
                  </a>
                </>
              ))}
            </p>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && category && (
        <section class="mt-14" aria-labelledby="judul-lain">
          <h2 id="judul-lain" class="mb-3 text-xl font-bold">Lainnya di {category.name}</h2>
          <ProductGrid products={related} />
        </section>
      )
    }
  </article>
</Base>
