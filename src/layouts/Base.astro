---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  jsonLd?: Record<string, unknown> | null;
  noindex?: boolean;
  reserveBottomBar?: boolean;
  // The owner's dashboard: no public search, menus, or footer.
  owner?: boolean;
}

const { title, description = site.description, image = null, jsonLd = null, noindex = false, reserveBottomBar = false, owner = false } = Astro.props;
// A bare "<" inside JSON-LD could close the script tag early.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image ?? '/brand/og.jpg', site.url).href;
const blockIndex = noindex || site.sampleMode;

const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Beranda', icon: 'home', active: path === '/' || path.startsWith('/kategori/') },
  { href: '/koleksi/', label: 'Koleksi', icon: 'list', active: path.startsWith('/koleksi/') },
  { href: '/panduan/', label: 'Panduan', icon: 'book', active: path.startsWith('/panduan/') },
  { href: '/favorit/', label: 'Favorit', icon: 'heart', active: path === '/favorit/' },
];
// Desktop has no bottom bar, so the same places (plus Tentang) sit in the header.
const headerLinks = [...tabs.slice(1), { href: '/tentang/', label: 'Tentang', icon: '', active: path === '/tentang/' }];

const icons: Record<string, string> = {
  home: '<path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z"/>',
  list: '<path d="M8.5 6.5H20M8.5 12H20M8.5 17.5H20"/><path d="m3.5 6.5 1 1 2-2M3.5 12l1 1 2-2M3.5 17.5l1 1 2-2"/>',
  book: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5zM20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5a1.5 1.5 0 0 1 1.5 1.5z"/>',
  heart: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>',
  person: '<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c.8-3.8 3.700-5.700 7.5-5.700s6.700 1.900 7.5 5.700"/>',
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#isi"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-3 focus:text-white"
    >
      Langsung ke isi
    </a>

    <header class="sticky top-0 z-40 bg-paper">
      <div class="wrap flex flex-wrap items-center gap-x-3 py-2">
        <a href="/" class="flex min-h-12 items-center gap-3 no-underline transition-opacity hover:opacity-75 active:opacity-60">
          <img src="/icon-192.png" alt="" width="192" height="192" class="size-11 rounded-full" />
          <span class="flex flex-col">
            <img src="/brand/listberdua.webp" alt={`${site.name}, ke beranda`} width="432" height="72" class="h-[1.15rem] w-auto" />
            <span class="mt-0.5 text-xs text-muted">Pilihan suami & istri</span>
          </span>
        </a>
        {
          owner ? (
            <a href="/" class="ml-auto inline-flex min-h-11 items-center rounded-full bg-card px-4 text-sm font-semibold no-underline hover:bg-line active:bg-line">
              Buka situs
            </a>
          ) : (
            <nav aria-label="Menu" class="ml-6 hidden lg:block">
              <ul class="flex gap-1">
                {headerLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.active ? 'page' : undefined}
                      class:list={[
                        'relative isolate inline-flex min-h-11 items-center rounded-full px-3.5 text-sm no-underline transition-colors hover:bg-card',
                        link.active ? 'font-semibold text-ink' : 'text-muted hover:text-ink',
                      ]}
                    >
                      {link.active && <span aria-hidden="true" class="absolute inset-0 -z-10 rounded-full bg-card" transition:name="menu-aktif" />}
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        {!owner && (
        <button
          type="button"
          id="buka-cari"
          aria-label="Cari barang"
          aria-expanded="false"
          aria-controls="form-cari"
          data-tip="Cari barang"
          data-tip-align="end"
          data-tip-below
          class="tip ml-auto flex size-11 items-center justify-center rounded-full bg-card text-ink transition-colors hover:bg-line active:bg-line md:hidden"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" />
          </svg>
        </button>
        <form action="/" method="get" role="search" id="form-cari" class="flex w-full gap-2 pb-1 pt-2 max-md:hidden md:ml-auto md:w-auto md:min-w-[22rem] md:p-0 xl:min-w-[26rem]">
          <input
            id="cari"
            name="q"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            aria-label="Cari produk atau kebutuhan"
            placeholder="Cari barang..."
            class="h-11 min-w-0 flex-1 rounded-full border border-edge bg-paper px-4 text-base placeholder:text-muted"
          />
          <button type="submit" class="btn btn-dark !min-h-11 !px-5">Cari</button>
        </form>
        )}
      </div>
    </header>

    {
      site.sampleMode && (
        <div class="bg-ink text-white">
          <p class="wrap py-2 text-sm">
            Mode contoh: produk, catatan suami istri, dan link di situs ini belum asli.
          </p>
        </div>
      )
    }

    <main id="isi" class="flex-1">
      <slot />
    </main>

    {!owner && (
    <footer class="mt-16 border-t border-line">
      <div class:list={['wrap grid gap-6 pt-8 text-sm text-muted md:grid-cols-[1fr_auto]', reserveBottomBar ? 'pb-28 md:pb-8' : 'pb-28 lg:pb-8']}>
        <div class="max-w-xl space-y-2">
          <p>
            Tombol beli di situs ini memakai link afiliasi Shopee. Kalau kamu membeli lewat link itu, kami mendapat
            komisi dari Shopee tanpa biaya tambahan untukmu.
          </p>
          <p>{site.name} bukan bagian dari Shopee dan tidak mewakili Shopee.</p>
        </div>
        <nav aria-label="Informasi situs">
          <ul class="flex flex-wrap gap-x-5 md:flex-col md:gap-0">
            <li><a class="inline-flex min-h-11 items-center text-ink hover:underline" href="/tentang/">Tentang ListBerdua</a></li>
            <li><a class="inline-flex min-h-11 items-center text-ink hover:underline" href="/pengungkapan-afiliasi/">Pengungkapan Afiliasi</a></li>
            <li><a class="inline-flex min-h-11 items-center text-ink hover:underline" href="/kebijakan-privasi/">Kebijakan Privasi</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    )}
    {owner && <div class="h-16" />}
    {
      !reserveBottomBar && !owner && (
        <nav aria-label="Menu utama" class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-paper pb-[env(safe-area-inset-bottom)] lg:hidden">
          <ul class="mx-auto flex max-w-md">
            {tabs.map((tab) => (
              <li class="flex-1">
                <a
                  href={tab.href}
                  aria-current={tab.active ? 'page' : undefined}
                  class:list={[
                    'relative isolate flex min-h-[3.75rem] flex-col items-center justify-center gap-0.5 text-xs no-underline',
                    tab.active ? 'font-semibold text-ink' : 'text-muted hover:text-ink',
                  ]}
                >
                  {tab.active && <span aria-hidden="true" class="absolute inset-x-2 inset-y-1.5 -z-10 rounded-2xl bg-card" transition:name="tab-aktif" />}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width={tab.active ? 2.2 : 1.7} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[tab.icon]} />
                  {tab.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </body>
</html>

<script>
  // Cards below the fold fade up once as they scroll in. Anything already on screen is left alone.
  let stopReveal = () => {};

  function setUpReveal() {
    stopReveal();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let waiting = [...document.querySelectorAll<HTMLElement>('[data-reveal]')].filter(
      (el) => el.getBoundingClientRect().top >= window.innerHeight,
    );
    waiting.forEach((el) => el.classList.add('reveal-wait'));

    let queued = false;
    // A scroll check also catches cards that a jump or anchor link skipped past.
    function check() {
      queued = false;
      const line = window.innerHeight * 0.94;
      let order = 0;
      waiting = waiting.filter((el) => {
        if (el.getBoundingClientRect().top > line) return true;
        el.style.transitionDelay = `${Math.min(order++, 5) * 60}ms`;
        el.classList.add('reveal-in');
        return false;
      });
      if (waiting.length === 0) stopReveal();
    }
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(check);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    stopReveal = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      stopReveal = () => {};
    };
  }

  // Favorites live in this browser only (localStorage); nothing is sent anywhere.
  function readFavorites(): string[] {
    try {
      const saved = JSON.parse(localStorage.getItem('lb-favorit') ?? '[]');
      return Array.isArray(saved) ? saved : [];
    } catch {
      return [];
    }
  }

  function setUpFavorites() {
    let saved = readFavorites();
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-favorit]');
    const list = document.querySelector<HTMLElement>('[data-daftar-favorit]');

    function paint() {
      buttons.forEach((b) => {
        const on = saved.includes(b.dataset.favorit!);
        b.setAttribute('aria-pressed', String(on));
        b.dataset.tip = on ? 'Hapus dari favorit' : 'Simpan ke favorit';
      });
      if (!list) return;
      list.setAttribute('data-siap', '');
      let shown = 0;
      list.querySelectorAll<HTMLElement>('[data-slug]').forEach((card) => {
        const keep = saved.includes(card.dataset.slug!);
        card.hidden = !keep;
        if (keep) shown++;
      });
      document.querySelector<HTMLElement>('#favorit-kosong')!.hidden = shown > 0;
      document.querySelector<HTMLElement>('#favorit-jumlah')!.textContent = shown > 0 ? `${shown} barang` : '';
    }

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const slug = button.dataset.favorit!;
        saved = saved.includes(slug) ? saved.filter((s) => s !== slug) : [...saved, slug];
        try {
          localStorage.setItem('lb-favorit', JSON.stringify(saved));
        } catch {
          // Private mode can block storage; the heart still toggles for this visit.
        }
        paint();
      }),
    );
    paint();
  }

  function setUpSearchToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('#buka-cari');
    const form = document.querySelector<HTMLFormElement>('#form-cari');
    const input = document.querySelector<HTMLInputElement>('#cari');
    // The owner's dashboard has no search.
    if (!toggle || !form || !input) return;
    const show = (open: boolean) => {
      form.classList.toggle('max-md:hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => {
      const open = form.classList.contains('max-md:hidden');
      show(open);
      if (open) input.focus();
    });
    if (new URLSearchParams(location.search).get('q')) show(true);
  }

  // Visit counting: one small request per page and per tap on a buy button. Only daily totals are kept on the
  // server; the browser remembers the date of its last visit so a visitor is counted once a day.
  const privacyOff = () =>
    (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true ||
    navigator.doNotTrack === '1';
  function store(key: string, value?: string) {
    try {
      if (value === undefined) return localStorage.getItem(key);
      localStorage.setItem(key, value);
    } catch {
      return null;
    }
    return null;
  }
  function send(events: { kind: string; key?: string }[]) {
    if (privacyOff() || store('lb-no-track') === '1' || location.pathname.startsWith('/admin')) return;
    const body = JSON.stringify(events);
    if (!navigator.sendBeacon?.('/api/hit', new Blob([body], { type: 'application/json' }))) {
      fetch('/api/hit', { method: 'POST', body, keepalive: true, headers: { 'content-type': 'application/json' } }).catch(() => {});
    }
  }
  function sourceOfVisit(): string | null {
    const tag = new URLSearchParams(location.search).get('utm_source') ?? new URLSearchParams(location.search).get('src');
    if (tag) return tag.toLowerCase().replace(/[^\w .-]/g, '').slice(0, 40) || null;
    let host = '';
    try {
      host = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : '';
    } catch {
      host = '';
    }
    if (host === location.hostname) return null;
    if (!host) return 'langsung';
    const known: [RegExp, string][] = [
      [/threads\./, 'threads'], [/instagram\./, 'instagram'], [/(facebook|fb)\./, 'facebook'], [/tiktok\./, 'tiktok'],
      [/(^|\.)(t\.co|x\.com|twitter\.com)$/, 'x'], [/whatsapp|wa\.me/, 'whatsapp'], [/google\./, 'google'], [/bing\./, 'bing'],
    ];
    return known.find(([pattern]) => pattern.test(host))?.[1] ?? host.slice(0, 40);
  }
  let firstPage = true;
  function countPage() {
    const events: { kind: string; key?: string }[] = [{ kind: 'view', key: location.pathname }];
    const today = new Date(Date.now() + 7 * 3600e3).toISOString().slice(0, 10);
    if (store('lb-hari') !== today) {
      store('lb-hari', today);
      events.push({ kind: 'visitor' });
    }
    // The source is counted once per tab session, so a reload or a later page does not count it again.
    if (firstPage) {
      firstPage = false;
      let counted = false;
      try {
        counted = sessionStorage.getItem('lb-asal') === '1';
        sessionStorage.setItem('lb-asal', '1');
      } catch {
        counted = false;
      }
      const source = counted ? null : sourceOfVisit();
      if (source) events.push({ kind: 'source', key: source });
    }
    send(events);
  }
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-klik]');
    if (link) send([{ kind: 'click', key: link.dataset.klik }]);
  });

  document.addEventListener('astro:page-load', countPage);
  document.addEventListener('astro:page-load', setUpReveal);
  document.addEventListener('astro:page-load', setUpFavorites);
  document.addEventListener('astro:page-load', setUpSearchToggle);
  // The hero entrance plays on the first page load only, not when coming back to the home page.
  document.addEventListener('astro:after-swap', () => document.documentElement.setAttribute('data-navigated', ''));
</script>
