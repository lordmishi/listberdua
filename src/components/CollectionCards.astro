---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { collections } from '../data/site';
import { byCollection, imageOf } from '../lib/catalog';

interface Props {
  // The home page leaves out empty collections; the Koleksi page lists them all.
  hideEmpty?: boolean;
}
const { hideEmpty = false } = Astro.props;

// Banner picture: an uploaded banner first, then the first product photo in the collection, then the illustration.
const banners = collections
  .map((c) => {
    const items = byCollection(c.name);
    const banner = `/images/koleksi/${c.slug}.jpg`;
    const photo = existsSync(join(process.cwd(), 'public', banner)) ? banner : (items.map(imageOf).find(Boolean) ?? null);
    return { ...c, count: items.length, photo };
  })
  .filter((c) => !hideEmpty || c.count > 0);
---

{
  banners.length > 0 && (
    <ul class="pill-row -mx-4 flex snap-x gap-3 overflow-x-auto px-4 md:mx-0 md:grid md:grid-cols-2 md:gap-4 md:overflow-visible md:px-0">
      {banners.map((c) => (
        <li class="w-[88%] shrink-0 snap-start md:w-auto">
          <a
            href={`/koleksi/${c.slug}/`}
            class="group grid h-full min-h-40 grid-cols-[1fr_34%] overflow-hidden sm:min-h-44 sm:grid-cols-[1fr_40%] rounded-[1.75rem] bg-panel text-white no-underline transition-colors hover:bg-panel-press active:bg-panel-press"
          >
            <span class="flex flex-col p-4 sm:p-5">
              <span class="text-lg font-bold leading-tight tracking-tight sm:text-xl">{c.name}</span>
              <span class="mt-1.5 text-sm leading-snug text-on-panel-muted">{c.blurb}</span>
              <span class="mt-auto pt-4">
                <span class="inline-flex min-h-10 items-center rounded-full bg-white px-4 text-sm font-semibold text-ink transition-transform group-active:scale-95">
                  {c.count > 0 ? `Lihat ${c.count} barang` : 'Segera diisi'}
                </span>
              </span>
            </span>
            {c.photo ? (
              <img src={c.photo} alt="" width="400" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            ) : (
              <img src="/brand/pasangan.webp" alt="" width="800" height="436" loading="lazy" decoding="async" class="w-full self-end pr-3" />
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}
