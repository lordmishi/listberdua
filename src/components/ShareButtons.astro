---
import { site } from '../data/site';

interface Props {
  path: string;
  title: string;
}
const { path, title } = Astro.props;
// Each channel adds its own ?src= so the dashboard shows where visits came from.
const linkFor = (src: string) => `${new URL(path, site.url).href}?src=${src}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title} ${linkFor('wa')}`)}`;
const threads = `https://www.threads.net/intent/post?text=${encodeURIComponent(`${title} ${linkFor('threads')}`)}`;
const round = 'tip flex size-12 items-center justify-center rounded-full bg-card text-ink no-underline transition-[background-color,transform] duration-150 hover:bg-line active:scale-90';
const icon = { width: 22, height: 22, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 1.8, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' } as const;
---

<div class="bagikan" data-judul={title} data-link={linkFor('bagikan')} data-link-salin={linkFor('salin')}>
  <p class="text-sm font-semibold">Bagikan</p>
  <ul class="mt-3 flex flex-wrap items-center gap-2.5">
    <li>
      <button type="button" class={round} data-aksi="salin" aria-label="Salin link" data-tip="Salin link" data-tip-align="start">
        <svg {...icon}><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
      </button>
    </li>
    <li>
      <a class={round} href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Kirim lewat WhatsApp" data-tip="Kirim lewat WhatsApp">
        <svg {...icon}><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /><path d="M9.5 9.5c0 2.5 2.5 5 5 5l1-1.5-2-1-1 .8a4 4 0 0 1-2.3-2.3l.8-1-1-2z" /></svg>
      </a>
    </li>
    <li>
      <a class={round} href={threads} target="_blank" rel="noopener noreferrer" aria-label="Bagikan ke Threads" data-tip="Bagikan ke Threads">
        <svg {...icon}><circle cx="12" cy="12" r="3.5" /><path d="M15.5 12v1.5a2.5 2.5 0 0 0 5 0V12a8.5 8.5 0 1 0-3.3 6.7" /></svg>
      </a>
    </li>
    <li hidden data-native>
      <button type="button" class={round} data-aksi="native" aria-label="Bagikan ke aplikasi lain" data-tip="Aplikasi lain">
        <svg {...icon}><path d="M12 15V4" /><path d="m8 7.5 4-3.5 4 3.5" /><path d="M7 11H6a1.5 1.5 0 0 0-1.5 1.5v6A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 18 11h-1" /></svg>
      </button>
    </li>
  </ul>
  <p class="mt-2 min-h-5 text-sm text-muted" role="status" data-pesan></p>
</div>

<script>
  function setUpShare() {
    document.querySelectorAll<HTMLElement>('.bagikan').forEach((box) => {
      if (box.dataset.siap) return;
      box.dataset.siap = '1';
      const message = box.querySelector<HTMLElement>('[data-pesan]')!;
      const nativeItem = box.querySelector<HTMLElement>('[data-native]')!;
      if (typeof navigator.share === 'function') nativeItem.hidden = false;

      box.querySelector('[data-aksi="native"]')!.addEventListener('click', async () => {
        try {
          await navigator.share({ title: box.dataset.judul, url: box.dataset.link });
        } catch {
          // Closing the share sheet is not an error worth showing.
        }
      });
      box.querySelector('[data-aksi="salin"]')!.addEventListener('click', async () => {
        const link = box.dataset.linkSalin!;
        try {
          await navigator.clipboard.writeText(link);
          message.textContent = 'Link disalin.';
          const button = box.querySelector<HTMLElement>('[data-aksi="salin"]')!;
          button.dataset.tip = 'Tersalin';
          setTimeout(() => (button.dataset.tip = 'Salin link'), 1600);
        } catch {
          message.textContent = `Salin link ini: ${link}`;
        }
      });
    });
  }
  document.addEventListener('astro:page-load', setUpShare);
</script>
