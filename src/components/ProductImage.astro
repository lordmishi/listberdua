---
import { imageOf, type Product } from '../lib/catalog';

interface Props {
  product: Product;
  priority?: boolean;
  onPanel?: boolean;
  class?: string;
}
const { product, priority = false, onPanel = false, class: className = '' } = Astro.props;
const src = imageOf(product);
---

{
  src ? (
    <img
      src={src}
      alt={product.name}
      width="800"
      height="800"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      transition:name={`foto-${product.slug}`}
      class:list={['aspect-square w-full object-cover', onPanel ? 'bg-panel' : 'tile', className]}
    />
  ) : (
    <div
      role="img"
      transition:name={`foto-${product.slug}`}
      aria-label={`Foto ${product.name} belum ada`}
      class:list={[
        'flex aspect-square w-full items-center justify-center p-3 text-center text-sm',
        onPanel ? 'bg-panel text-on-panel-muted' : 'tile text-muted',
        className,
      ]}
    >
      Foto belum ada
    </div>
  )
}
