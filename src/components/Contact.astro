---
import { site } from '../data/site';
---

{
  site.contactEmail ? (
    <p>
      Ada pertanyaan? Kirim email ke <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
    </p>
  ) : (
    <p class="rounded-xl border border-dashed border-edge bg-blank px-3 py-2">
      [Email kontak belum diisi. Isi contactEmail di src/data/site.ts sebelum situs dipublikasikan.]
    </p>
  )
}
