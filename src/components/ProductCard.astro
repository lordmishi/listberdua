---
import ProductImage from './ProductImage.astro';
import FavoriteButton from './FavoriteButton.astro';
import { searchText, type Product } from '../lib/catalog';

interface Props {
  product: Product;
  priority?: boolean;
}
const { product, priority = false } = Astro.props;
// Lowest price as a plain number for the sort menu ("Mulai Rp1.399.000" counts as 1399000).
const sortPrice = /Rp\s?([\d.]+)/.exec(product.priceEstimate ?? '')?.[1].replace(/\./g, '') ?? '';
// One real voice on the card is what a store listing cannot offer.
const note = product.wifeNote
  ? { who: 'Istri', text: product.wifeNote }
  : product.husbandNote
    ? { who: 'Suami', text: product.husbandNote }
    : null;
---

<li data-cari={searchText(product)} data-slug={product.slug} data-harga={sortPrice || undefined} data-reveal class="relative">
  <a href={`/produk/${product.slug}/`} class="group block rounded-[1.5rem] no-underline transition-transform duration-150 active:scale-[0.98]">
    <div class="relative overflow-hidden rounded-[1.5rem]">
      <ProductImage product={product} priority={priority} class="transition-transform duration-300 ease-out group-hover:scale-[1.04]" />
      {
        product.storeBadge && (
          <span class="absolute bottom-2.5 left-2.5 rounded-full bg-paper px-2.5 py-1 text-xs font-semibold">
            {product.storeBadge}
          </span>
        )
      }
    </div>
    <div class="px-1 pt-2.5">
      <h3 class="line-clamp-2 text-[0.95rem] font-semibold leading-snug tracking-normal group-hover:underline">{product.name}</h3>
      <p class="mt-0.5 text-[0.95rem] font-bold">{product.priceEstimate}</p>
      {
        note ? (
          <p class="mt-1 line-clamp-2 text-sm leading-snug text-muted">
            <span class="font-semibold text-ink">{note.who}:</span> “{note.text}”
          </p>
        ) : (
          product.quickTag && <p class="mt-1 text-sm text-muted">{product.quickTag}</p>
        )
      }
    </div>
  </a>
  <FavoriteButton slug={product.slug} name={product.name} class="absolute right-1.5 top-1.5 !bg-transparent" />
</li>
