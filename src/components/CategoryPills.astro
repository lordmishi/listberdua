---
import { categories } from '../data/site';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const items = [{ slug: '', name: 'Semua' }, ...categories];
const base = 'inline-flex min-h-11 shrink-0 items-center rounded-full px-4 text-sm font-medium no-underline transition-colors';
---

<nav aria-label="Kategori" class="wrap">
  <ul class="pill-row -mx-4 flex gap-2 overflow-x-auto px-4 py-3 lg:mx-0 lg:flex-wrap lg:px-0">
    {
      items.map((c) => {
        const active = c.slug === current;
        return (
          <li class="shrink-0">
            <a
              href={c.slug ? `/kategori/${c.slug}/` : '/'}
              aria-current={active ? 'page' : undefined}
              class:list={[base, active ? 'bg-ink text-white' : 'bg-card text-ink hover:bg-line active:bg-line']}
            >
              {c.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
