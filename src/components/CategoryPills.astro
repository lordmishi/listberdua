---
import { categories } from '../data/site';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const items = [{ slug: '', name: 'Semua' }, ...categories];
const base = 'relative isolate inline-flex min-h-11 shrink-0 items-center rounded-full px-4 text-sm font-medium no-underline transition-colors';
---

<nav aria-label="Kategori" class="wrap">
  <ul class="pill-row -mx-4 flex gap-2 overflow-x-auto px-4 py-1 lg:mx-0 lg:flex-wrap lg:px-0">
    {
      items.map((c) => {
        const active = c.slug === current;
        return (
          <li class="shrink-0">
            <a
              href={c.slug ? `/kategori/${c.slug}/` : '/'}
              aria-current={active ? 'page' : undefined}
              class:list={[base, active ? 'text-white' : 'bg-card text-ink hover:bg-line active:bg-line']}
            >
              {/* The dark pill slides to the chosen category when the page changes. */}
              {active && <span aria-hidden="true" class="absolute inset-0 -z-10 rounded-full bg-ink" transition:name="kategori-aktif" />}
              {c.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  // Keep the chosen category visible in the scrolling row without moving the page.
  function showActivePill() {
    document.querySelectorAll<HTMLElement>('nav[aria-label="Kategori"] .pill-row').forEach((row) => {
      const active = row.querySelector<HTMLElement>('[aria-current="page"]');
      if (!active || row.scrollWidth <= row.clientWidth) return;
      row.scrollLeft = active.offsetLeft - (row.clientWidth - active.offsetWidth) / 2;
    });
  }
  document.addEventListener('astro:page-load', showActivePill);
</script>
